# 阿里百炼 DashScope（https://bailian.console.aliyun.com/ 创建 API-KEY）
DASHSCOPE_API_KEY=sk-replac…here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择
VLM_MODEL=qwen-vl-max
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 本地
DATABASE_PATH=./data/campus.db
SESSION_SECRET=replac…ring
# 注册第一个账号时设为 1，该账号自动成为管理员
FIRST_USER_IS_ADMIN=0
